# =========================================
# Backend env TEMPLATE
# Copy to .env (git-ignored) and edit.
# =========================================

# Server
# PORT is set by docker-compose from the BACKEND_PORT env var.
# NODE_ENV=production

# Where uploaded files live inside the container.
# The compose file bind-mounts /var/express-uploads → this path so files
# survive container restarts and are accessible from the host.
UPLOAD_ROOT=/var/express-uploads

# CORS
ORIGIN=*
CREDENTIALS=true

# Auth — set this to a long random string in any real deployment.
SECRET_KEY=replace-me-with-a-long-random-string

# MongoDB — no authentication (local dev only).
# For production, either enable auth (see docker-compose.mongo.yml) or
# point MONGODB_URI at an external authenticated cluster.
MONGODB_URI=mongodb://mongo:27017/express-upload

# Logging
LOG_FORMAT=combined
LOG_DIR=/app/logs
