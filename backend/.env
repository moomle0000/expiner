# =========================================
# Backend env used by docker-compose
# This file is loaded automatically by docker-compose.
# =========================================

# Server
# PORT is set by docker-compose from the SERVER_PORT env var.
# Keeping a default here would shadow that, so we leave it commented.
# PORT=5601
NODE_ENV=production

# Where uploaded files live inside the container.
# The compose file bind-mounts /var/express-uploads → this path so files
# survive container restarts and are accessible from the host.
UPLOAD_ROOT=/var/express-uploads

# CORS
ORIGIN=*
CREDENTIALS=true

# Auth
SECRET_KEY=change-me-in-real-deployments
# MongoDB — no authentication (local dev only).
# If you need auth, switch the MONGODB_URI to:
#   mongodb://${MONGO_USER}:${MONGO_PASSWORD}@mongo:27017/${MONGO_DB}?authSource=admin
# and re-enable MONGO_INITDB_ROOT_USERNAME/PASSWORD on the mongo service.
MONGODB_URI=mongodb://mongo:27017/image-upload
# Logging
LOG_FORMAT=combined
LOG_DIR=/app/logs
