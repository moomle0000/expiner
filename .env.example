# =====================================================
# express-upload — docker-compose env TEMPLATE
# Copy to .env (git-ignored) and edit for your machine.
# =====================================================

# ---- Host ports mapped to the containers ----
BACKEND_PORT=5601
FRONTEND_PORT=3055

# ---- Frontend → backend URL ----
# Read at build time (baked into the JS bundle) and at runtime
# (fetched from /api/_config on every page load).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5601

# ---- Backend → MongoDB ----
# In-cluster (default):     mongodb://mongo:27017/express-upload
# External:                 mongodb://user:pass@host:27017/db
# Atlas (SRV):              mongodb+srv://user:pass@cluster.example.net/db
MONGODB_URI=mongodb://mongo:27017/express-upload

# ---- Auth ----
# Generate with: openssl rand -base64 64
SECRET_KEY=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Set this to the public URL the browser uses to reach the frontend.
FRONTEND_ORIGIN=http://localhost:3055

# ---- Optional: enable Mongo auth ----
# Uncomment in docker-compose.mongo.yml's `mongo` service AND set
# MONGODB_URI to the authed form (?authSource=admin) to enable.
# MONGO_USER=expressupload
# MONGO_PASSWORD=replace-me

# ---- Bootstrap users (created on first boot, no-op if email exists) ----
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_USER_EMAIL=user@example.com
BOOTSTRAP_USER_PASSWORD=ChangeMe123!
BOOTSTRAP_USER_NAME=User
