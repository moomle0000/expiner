# =====================================================
# express-upload — docker-compose env
# Loaded automatically by `docker compose` from this
# directory. Edit values here, then `docker compose up -d --build`.
# =====================================================

# ---- Host ports mapped to the containers ----
BACKEND_PORT=5601
FRONTEND_PORT=3055

# ---- Frontend → backend URL ----
# Read at two points:
#   - Build time: docker-compose passes this as a build-arg to the
#     frontend image. Next.js inlines `NEXT_PUBLIC_*` vars into the
#     bundle, so the value here is what the very first client paint
#     (and the SSR pass) uses.
#   - Runtime: the same var is passed as an env to the frontend
#     container. `pages/api/_config.ts` reads it per request and
#     `_app.tsx` fetches that endpoint on mount to set
#     `window.__API_BASE_URL__`. From that point on, the axios
#     interceptor uses it.
# This means: change this var, run `docker compose up -d --build
# frontend` (rebuild is required for SSR; the runtime value kicks in
# on the next browser reload even without a rebuild).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5601

# ---- Backend → MongoDB ----
# Default: in-cluster mongo service (the `mongo` container).
# To use an external Mongo, set this to its full connection string and
# either skip the `mongo` service in `docker compose up` or just let
# it sit idle. Examples:
#   mongodb://mongo:27017/image-upload         (in-cluster, no auth)
#   mongodb://user:pass@mongo:27017/db?authSource=admin  (in-cluster, authed)
#   mongodb://192.168.100.157:27017/image      (external host)
#   mongodb+srv://cluster.example.net/db       (Atlas)
MONGODB_URI=mongodb://mongo:27017/image-upload

# ---- Auth ----
# CHANGE ME in any real deployment. The backend's config/index.ts
# reads SECRET_KEY (and aliases JWT_SECRET to it).
SECRET_KEY=change-me-in-real-deployments
JWT_EXPIRES_IN=7d

# ---- CORS ----
# `app.ts` reads FRONTEND_ORIGIN and appends it to the CORS allowlist
# (in addition to the hardcoded localhost:3055, localhost:5173, and
# the lmstream.xyz domains). Set this to the public URL the browser
# uses to reach the frontend.
FRONTEND_ORIGIN=http://localhost:3055

# ---- Optional: enable Mongo auth ----
# Uncomment both vars here AND in docker-compose.yml's `mongo` service
# to turn on authentication. Update MONGODB_URI accordingly.
# MONGO_USER=expressupload
# MONGO_PASSWORD=change-me-too

BOOTSTRAP_ADMIN_EMAIL=admin@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=11223344NNmm
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_USER_EMAIL=user@gmail.com
BOOTSTRAP_USER_PASSWORD=11223344NNmm
BOOTSTRAP_USER_NAME=User